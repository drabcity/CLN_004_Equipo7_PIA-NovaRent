  "components": {
    "schemas": {
      "CompensacionEntrada": {
        "properties": {
          "acepta_upgrade": {
            "type": "boolean",
            "title": "Acepta Upgrade",
            "default": false
          },
          "acepta_downgrade": {
            "type": "boolean",
            "title": "Acepta Downgrade",
            "default": false
          }
        },
        "type": "object",
        "title": "CompensacionEntrada"
      },
      "CrearReservacionEntrada": {
        "properties": {
          "categoria": {
            "type": "string",
            "minLength": 1,
            "title": "Categoria",
            "examples": [
              "Compacta"
            ]
          },
          "pago_inicial_centavos": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Pago Inicial Centavos",
            "examples": [
              100000
            ]
          },
          "duracion_dias": {
            "type": "integer",
            "maximum": 365.0,
            "minimum": 1.0,
            "title": "Duracion Dias",
            "default": 2
          }
        },
        "type": "object",
        "required": [
          "categoria",
          "pago_inicial_centavos"
        ],
        "title": "CrearReservacionEntrada"
      },
      "DevolucionEntrada": {
        "properties": {
          "hora_devolucion_minuto": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Hora Devolucion Minuto"
          },
          "inspeccion_devolucion": {
            "$ref": "#/components/schemas/InspeccionEntrada"
          }
        },
        "type": "object",
        "required": [
          "hora_devolucion_minuto",
          "inspeccion_devolucion"
        ],
        "title": "DevolucionEntrada"
      },
      "DocumentacionEntrada": {
        "properties": {
          "titular_licencia": {
            "type": "string",
            "minLength": 1,
            "title": "Titular Licencia",
            "examples": [
              "Ana Perez"
            ]
          },
          "edad": {
            "type": "integer",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Edad",
            "examples": [
              30
            ]
          },
          "vigencia_licencia_minuto": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Vigencia Licencia Minuto"
          },
          "vigencia_identificacion_minuto": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Vigencia Identificacion Minuto"
          },
          "identidad_verificada": {
            "type": "boolean",
            "title": "Identidad Verificada"
          }
        },
        "type": "object",
        "required": [
          "titular_licencia",
          "edad",
          "vigencia_licencia_minuto",
          "vigencia_identificacion_minuto",
          "identidad_verificada"
        ],
        "title": "DocumentacionEntrada"
      },
      "EntregaEntrada": {
        "properties": {
          "ultimos_4_tarjeta": {
            "type": "string",
            "pattern": "^[0-9]{4}$",
            "title": "Ultimos 4 Tarjeta",
            "examples": [
              "4242"
            ]
          },
          "titular_tarjeta": {
            "type": "string",
            "minLength": 1,
            "title": "Titular Tarjeta",
            "examples": [
              "Ana Perez"
            ]
          },
          "inspeccion_salida": {
            "$ref": "#/components/schemas/InspeccionEntrada"
          }
        },
        "type": "object",
        "required": [
          "ultimos_4_tarjeta",
          "titular_tarjeta",
          "inspeccion_salida"
        ],
        "title": "EntregaEntrada"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "InspeccionEntrada": {
        "properties": {
          "kilometraje": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Kilometraje",
            "examples": [
              12000
            ]
          },
          "combustible_octavos": {
            "type": "integer",
            "maximum": 8.0,
            "minimum": 0.0,
            "title": "Combustible Octavos",
            "examples": [
              8
            ]
          },
          "marcas_de_dano": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Marcas De Dano",
            "default": 0
          },
          "fotografias": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Fotografias",
            "default": 1
          },
          "esquema_completado": {
            "type": "boolean",
            "title": "Esquema Completado",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "kilometraje",
          "combustible_octavos"
        ],
        "title": "InspeccionEntrada"
      },
      "MantenimientoEntrada": {
        "properties": {
          "motivo": {
            "type": "string",
            "minLength": 1,
            "title": "Motivo"
          },
          "monto_centavos": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Monto Centavos"
          }
        },
        "type": "object",
        "required": [
          "motivo",
          "monto_centavos"
        ],
        "title": "MantenimientoEntrada"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    },
    "securitySchemes": {
      "APIKeyHeader": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key"
      }
    }
  }
}